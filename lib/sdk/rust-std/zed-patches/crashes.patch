+// The minidump crash handler everywhere it exists, and MikuOS's own report
+// where it does not
+#[cfg(not(target_os = "miku"))]
+#[path = "crashes.rs"]
+mod imp;
+#[cfg(target_os = "miku")]
+#[path = "miku.rs"]
+mod imp;
+
+pub use imp::*;
diff --git a/crates/crashes/src/miku.rs b/crates/crashes/src/miku.rs
new file mode 100644

# /etc/passwd: the accounts on this machine
#
#   name:x:uid:gid:description:home:shell
#
# The second field is 'x' on every line: the password hash lives in /etc/shadow,
# which is not world-readable. This file is, since every program printing an
# owner's name reads it.
#
# The last field is the session program: /bin/maysession reads
# /etc/mayland/session.d and starts the desktop listed there.
#
# Root's shadow entry is locked; the way to become root is `mikudo`, which
# records who did it and why they were allowed to.
root:x:0:0:root:/root:/bin/mayterm
# In `wheel`, so mikudo accepts this account
miku:x:1000:1000:MikuOS user:/home/miku:/bin/maysession
# Carries the negi desktop (end4's, forked), with stickers, notes and fonts, in
# an image built with `personal/`. Locked in /etc/shadow until the build puts
# its line there from `personal/shadow`, which git ignores (dev/aosh-negi.md)
alunwrd:x:1001:1001:alunwrd:/home/alunwrd:/bin/maysession
# The account the login screen runs as, and the only member of `session`. No
# password and no session program: it is the program that asks who is logging
# in. It holds CAP_MAY_PRIV, from its unit file, for as long as nobody is logged
# in
greeter:x:990:990:Login screen:/:/bin/false
# The owner of nothing, and the identity a file gets when its on-disk owner does
# not fit in sixteen bits (fold_id in kernel/process/cred.rs)
nobody:x:65534:65534:nobody:/:/bin/false

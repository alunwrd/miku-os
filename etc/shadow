# /etc/shadow: the password hashes
#
#   name:hash:last_change:min:max:warn:inactive:expire:reserved
#
# Mode 0640, root:shadow. Only mikudod reads and writes it: `passwd` asks the
# daemon rather than editing the file, so no program on this machine needs to be
# setuid.
#
# The hash field is Argon2id:
#
#   $argon2id$v=19$m=19456,t=3,p=1$<salt>$<tag>
#
# and two values that are not hashes:
#
#   !   locked, no password matches
#   *   the same
#
# Root is locked. The way to become root is `mikudo`, which records who did it
# and which line of /etc/mikudo.conf allowed it.
root:!:20334:0:99999:7:::
miku:$argon2id$v=19$m=19456,t=3,p=1$FQfE9u5u84JwTnz2U2x28A$Xcb7OIeMIWUdIl5VH1ZQbGFPWPMbDaeugc1YjsqdGLI:20334:0:99999:7:::
# Locked here. The build puts its line in place from `personal/shadow`, made
# with lib/admin/mikuauth's `mkshadow` and ignored by git; a build without one ships
# the account locked
alunwrd:!:20334:0:99999:7:::
# The login screen's account, locked as root is: a program, not a person
greeter:!:20334:0:99999:7:::
nobody:!:20334:0:99999:7:::
